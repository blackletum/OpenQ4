// Experimental level editor; stock Quake 4 artwork only.
windowDef Desktop {
 rect 0,0,640,480
 menugui 1
 backcolor 0.025,0.032,0.02,1
 definevec4 white_8 1,1,1,0.8
 definevec4 orange 0.890,0.537,0,1
 definevec4 orange_4 0.890,0.537,0,0.4
 onESC {
  if ( "gui::ed_confirm" == 1 ) { set "cmd" "editorExperimentalAction cancel"; }
  else { set "cmd" "editorExperimentalAction hide"; }
 }
 onNamedEvent workspaceConfirm { setFocus "confirm_cancel"; }
 onNamedEvent workspaceResume { setFocus "edBrowser"; }
windowDef heading { rect (16),(5),(170),(25) noevents 1 text "#str_42900" font "fonts/lowpixel" textscale .29 textspacing -1 forecolor 0.890,0.537,0,1 }
windowDef experimental { rect (190),(10),(112),(18) noevents 1 text "#str_42946" font "fonts/lowpixel" textscale .17 textspacing -1 forecolor 0.890,0.537,0,1 }
windowDef document { rect (310),(10),(222),(18) noevents 1 text "gui::ed_title" font "fonts/lowpixel" textscale .17 textspacing -1 forecolor 0.72,0.76,0.63,1 }
windowDef dirty { rect (536),(10),(90),(18) noevents 1 text "gui::ed_dirty" font "fonts/lowpixel" textscale .17 textspacing -1 forecolor 0.890,0.537,0,1 }
windowDef tool_new { rect (16),(34),(64),(25) noevents "gui::ed_confirm" background "gfx/guis/mainmenu/b6_light" matcolor 0.545,0.588,0.294,0.62
 onMouseEnter {
  if ( "gui::ed_confirm" == 0 ) {
   stoptransitions "tool_new";
   set "tool_new::matcolor_w" "1";
   transition "tool_new_label::forecolor" "$desktop::white_8" "$desktop::orange" "0";
   transition "tool_new_corner::matcolor" "$desktop::orange_4" "$desktop::orange" "0";
   set "cmd" "play main_menu_mouseover";
  }
 }
 onMouseExit {
  transition "tool_new::matcolor_w" "1" "0.62" "300";
  transition "tool_new_label::forecolor" "$desktop::orange" "$desktop::white_8" "300";
  transition "tool_new_corner::matcolor" "$desktop::orange" "$desktop::orange_4" "300";
 }
 onAction { set "cmd" "play main_menu_selection ; editorExperimentalAction new"; } }
